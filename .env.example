WEB_HOST=127.0.0.1
PORT=9005
SMTP_HOST=0.0.0.0
SMTP_PORT=2500
# Optional authenticated HTTP receiver on a separate port; disabled without a token.
INBOUND_PORT=9006
INBOUND_TOKEN=
DATABASE_URL=sqlite://data/mailthing.db
# Initial defaults; editable in the app's Settings after first launch.
MAILBOX_NAME=My mailbox
MAILBOX_EMAIL=me@mailthing.local
# Outbound relay; sending is disabled until SMTP_RELAY_HOST is set.
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=
# starttls (default), tls (usually port 465), or plain (local relay only).
SMTP_RELAY_SECURITY=starttls
# Optional incoming SMTP STARTTLS certificate and private key (PEM).
SMTP_TLS_CERT=
SMTP_TLS_KEY=
PIPELINE_CONCURRENCY=4
MAX_MESSAGE_BYTES=26214400
WEB_ASSETS=dist/web
RUST_LOG=mailthing=info,tower_http=info
# Apple Push Notification service; optional, all three credentials required together.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.ericjohney.mailthing
# PKCS#8 .p8 contents, with actual newlines or escaped \n. Keep in a secret store.
APNS_PRIVATE_KEY=

# Optional LiteLLM/OpenAI-compatible sorting. Set all three together to enable.
# Base URL includes /v1; the model is the exact alias advertised by your proxy.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
