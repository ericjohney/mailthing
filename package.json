{
  "name": "mailthing",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build:css": "tailwindcss -i src/client/globals.css -o dist/public/globals.css --minify",
    "build:js": "bun build src/client/main.tsx --outdir dist/public --minify",
    "build": "bun run build:css && bun run build:js && cp src/client/index.html dist/public/",
    "start": "NODE_ENV=production bun run src/index.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.60.0",
    "@trpc/client": "^11.0.0-rc.608",
    "@trpc/react-query": "^11.0.0-rc.608",
    "@trpc/server": "^11.0.0-rc.608",
    "better-sqlite3": "^11.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "mailparser": "^3.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smtp-server": "^3.13.6",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/bun": "^1.1.14",
    "@types/mailparser": "^3.4.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/smtp-server": "^3.5.10",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2"
  }
}
